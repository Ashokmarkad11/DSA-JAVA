public class mergesort {

    private static void mergeSort(int[] arr, int l, int r) {

        if (l < r) {

            int mid = (l + r) / 2;

            // Divide left part
            mergeSort(arr, l, mid);

            // Divide right part
            mergeSort(arr, mid + 1, r);

            // Merge both sorted parts
            merge(arr, l, mid, r);
        }
    }

    private static void merge(int[] arr, int l, int mid, int r) {

        int n1 = mid - l + 1;  // l to mid
        int n2 = r - mid;      // mid+1 to r

        int larr[] = new int[n1];
        int rarr[] = new int[n2];

        // Copy left part
        for (int x = 0; x < n1; x++) {
            larr[x] = arr[l + x];
        }

        // Copy right part
        for (int x = 0; x < n2; x++) {
            rarr[x] = arr[mid + 1 + x];
        }

        int i = 0;  // left array index
        int j = 0;  // right array index
        int k = l;  // original array index

        // Compare left and right arrays
        while (i < n1 && j < n2) {

            if (larr[i] <= rarr[j]) {
                arr[k] = larr[i];
                i++;
            }
            else {
                arr[k] = rarr[j];
                j++;
            }

            k++;
        }

        // Copy remaining elements from left array
        while (i < n1) {
            arr[k] = larr[i];
            i++;
            k++;
        }

        // Copy remaining elements from right array
        while (j < n2) {
            arr[k] = rarr[j];
            j++;
            k++;
        }
    }

    public static void main(String[] args) {

        int arr[] = {3, 5, 1, 4, 6, 2};

        System.out.println("Before Sorting");

        for (int n : arr) {
            System.out.print(n + " ");
        }

        System.out.println();

        mergeSort(arr, 0, arr.length - 1);

        System.out.println("After Sorting");

        for (int n : arr) {
            System.out.print(n + " ");
        }
    }
} 
