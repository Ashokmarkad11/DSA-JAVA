package Queue;

public class Runner {
    public static void main(String[] args) {
        Queue q = new Queue();
        q.enQueue(5);
        q.enQueue(2);
        q.enQueue(7);
        q.enQueue(3);

        q.deQueue();


        q.enQueue(6);
        q.enQueue(37);
        q.enQueue(43);

//        System.out.println(q.isEmpty());
        System.out.println(q.isFull());

        System.out.println("Size "+q.getSize());

        q.show();

    }
}
